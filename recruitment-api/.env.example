# Copy to .env. Never commit or share the real .env file.
APP_ENV=development
SECRET_KEY=
DATABASE_URL=sqlite:///./recruitment.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=uploads
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LOG_LEVEL=INFO

# Security and startup controls
# AUTO_CREATE_SCHEMA defaults to false in production; apply Alembic migrations.
SEED_DEFAULT_JOBS=false
