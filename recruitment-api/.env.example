# Copy to .env. Never commit or share the real .env file.
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./recruitment.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=uploads
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LOG_LEVEL=INFO

# Security and startup controls
ALLOW_PUBLIC_HR_REGISTRATION=false
AUTO_CREATE_SCHEMA=true
SEED_DEFAULT_JOBS=true
